{
  "manifest_version": 3,
  "name": "Ollama 网页翻译",
  "version": "1.0",
  "description": "调用本地 Ollama 翻译页面所有 p li 标签文本",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Ollama 翻译",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
